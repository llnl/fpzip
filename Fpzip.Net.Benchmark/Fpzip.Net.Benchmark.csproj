<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework> <!-- Must match Fpzip.Net's TargetFramework -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FpzipNetBenchmark</AssemblyName> <!-- To avoid conflict with Fpzip.Net namespace if class is also FpzipBenchmark -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
    <!-- Using a recent, known stable version. Check for latest if needed. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fpzip.Net\Fpzip.Net.csproj" />
  </ItemGroup>

  <!-- Copy native executable to output directory if it's pre-built or built by a script -->
  <!-- This example assumes the workflow will place it where it can be found, or use a path. -->
  <!--
  <ItemGroup>
    <None Update="path/to/native/fpzip_cli_executable">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  -->

</Project>
